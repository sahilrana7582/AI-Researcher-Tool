# Copy this file to .env and fill in the secrets.
# Real environment variables take priority over values in .env.

APP_NAME=ai-researcher

# dev | test | prod
ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

LLM_API_KEY=your-api-key-here

# Always set the model explicitly; library defaults change.
LLM_MODEL=gpt-6-luna

# Total time allowed for a single LLM request, and how many times the
# client retries transient failures (rate limits, 5xx, connection errors).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
