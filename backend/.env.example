# Copy this file to .env and fill in the secrets.
# Real environment variables take priority over values in .env.

APP_NAME=ai-researcher

# dev | test | prod
ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

LLM_API_KEY=your-api-key-here

# Always set the model explicitly; library defaults change.
LLM_MODEL=gpt-6-luna

# Network timeout for LLM requests: how long to wait for the connection and
# for the next bytes of the response. It is not a cap on total streaming time.
# Retries apply to transient failures (rate limits, 5xx, connection errors)
# before a response starts; a stream that fails midway is not retried.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
